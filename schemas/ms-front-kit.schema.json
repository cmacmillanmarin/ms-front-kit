{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ms-front-kit project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "framework", "paths", "components", "styles"],
  "properties": {
    "version": { "const": 1 },
    "framework": { "enum": ["vue", "nuxt"] },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "composables", "styles"],
      "properties": {
        "components": { "type": "string", "minLength": 1 },
        "composables": { "type": "string", "minLength": 1 },
        "store": {
          "type": "string",
          "minLength": 1,
          "description": "Pinia store directory. Optional: defaults to a store directory beside composables."
        },
        "styles": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naming", "style", "bem"],
      "properties": {
        "naming": { "const": "PascalCase" },
        "style": { "const": "scss" },
        "bem": { "const": true }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid"],
      "properties": {
        "grid": {
          "type": "boolean",
          "description": "Installation marker for the SCSS grid foundation. add styles also installs a development overlay helper; this flag does not control its visibility."
        }
      }
    }
  }
}
